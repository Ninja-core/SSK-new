rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Protected admin collection: student notes & study materials
    // All modifications and reads must pass through the verified admin server gateway
    match /studyMaterials/{document=**} {
      allow read, write: if false;
    }

    // Default lockdown for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
